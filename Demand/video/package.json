{
  "name": "booklesss-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project for Booklesss demo videos and motion social posts",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render",
    "render:vertical": "remotion render DemoVertical out/demo-vertical.mp4",
    "render:wide": "remotion render DemoWide out/demo-wide.mp4",
    "still": "remotion still",
    "sync:shots": "node scripts/sync-shots.mjs",
    "render:demo": "remotion render ProductDemo out/product-demo.mp4",
    "upgrade": "remotion upgrade",
    "build:icons": "node scripts/build-icons.mjs",
    "render:action": "remotion render InAction out/booklesss-in-action.mp4",
    "voice:placeholder": "powershell -ExecutionPolicy Bypass -File scripts/voice-placeholder.ps1",
    "gen:audio": "python scripts/gen-audio.py",
    "render:explainer": "remotion render Explainer-present-value out/explainer-present-value.raw.mp4 && node scripts/master.mjs out/explainer-present-value.raw.mp4 out/explainer-present-value.mp4",
    "qa:explainer": "remotion still ExplainerSheet out/_explainer-qa.png",
    "export:pixels": "node scripts/export-pixels.mjs",
    "footage": "python scripts/footage.py",
    "mux": "node scripts/mux-audio.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.499",
    "@remotion/fonts": "^4.0.499",
    "@remotion/media-utils": "^4.0.499",
    "@remotion/transitions": "^4.0.499",
    "@remotion/zod-types": "^4.0.499",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.499",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web": "^0.0.353",
    "typescript": "^5.9.3"
  }
}
