# ── Supabase (auth + data) ──────────────────────────────────
# Without the two NEXT_PUBLIC_* vars the app builds and runs signed-out only —
# every auth surface no-ops (see lib/auth.ts `authEnabled`). The anon key is
# safe in a browser by design: it is what signs a student in, and RLS is what
# limits what it can read.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — NEVER NEXT_PUBLIC. Used by lib/supabase-admin (a `server-only`
# module) for the API routes' writes. Without it those routes answer
# `{ ok: false, reason: "no-db" }` and the app carries on against the
# device's own copy.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# (The Clerk block that used to live here went with Clerk on 2026-08-05.)
