# ── Clerk (identity + auth UI) ──────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: only if the Clerk↔Supabase link uses a named JWT template
# instead of the native integration.
# CLERK_SUPABASE_JWT_TEMPLATE=supabase
# Clerk Billing plan slugs that grant member (paid) access — comma-separated.
# Must match the plan slugs created in Clerk Billing. Defaults to `basic,pro`.
# CLERK_MEMBER_PLANS=basic,pro

# ── Supabase (data only — no Supabase Auth) ─────────────────
# Clerk is registered as a Supabase third-party auth provider; RLS reads the
# Clerk user id from the JWT `sub` claim.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
