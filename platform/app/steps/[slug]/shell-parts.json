 "tip": "<div class=\"tip\" id=\"tip\" data-place=\"above\" role=\"tooltip\" aria-live=\"polite\"></div>",
 "voice": "<!-- Booklesss voice tutor — placeholder orb (ElevenLabs agent slot, not yet live).\n     Fixed bottom-right. Idle = amber standby; Active = listening (green dot,\n     expanding rings, breathing). Click toggles the demo state. Replaced by the\n     real <elevenlabs-convai> widget once a step's voice_agent_id is set. -->\n<style>\n  .bk-orb {\n    position: fixed; right: clamp(1rem, 3vw, 1.75rem); bottom: clamp(1rem, 3vw, 1.75rem);\n    z-index: 55; display: flex; align-items: center; gap: 0.6rem;\n    font-family: \"Satoshi\", \"Onest\", system-ui, sans-serif;\n  }\n  .bk-orb-label {\n    order: -1;\n    background: #f0efeb; color: #18181B;\n    border: 1px solid #e8e8e8;\n    border-radius: 999px;\n    padding: 0.5rem 0.85rem; font-size: 0.8125rem; font-weight: 600;\n    white-space: nowrap; box-shadow: 0 10px 24px -12px rgba(24,24,27,0.28);\n    opacity: 0; transform: translateX(8px);\n    transition: opacity 240ms cubic-bezier(0.16,1,0.3,1), transform 240ms cubic-bezier(0.16,1,0.3,1);\n    pointer-events: none;\n  }\n  .bk-orb:hover .bk-orb-label,\n  .bk-orb[data-state=\"active\"] .bk-orb-label { opacity: 1; transform: none; }\n  .bk-orb-label .soon {\n    margin-left: 0.45rem; font-size: 0.625rem; font-weight: 700;\n    letter-spacing: 0.08em; text-transform: uppercase; color: #c5613f;\n  }\n  .bk-orb[data-state=\"active\"] .bk-orb-label .soon { display: none; }\n  .bk-orb-btn {\n    position: relative; width: 40px; height: 40px; flex: none;\n    border: none; cursor: pointer; padding: 10px; border-radius: 50%;\n    background: #c5613f; color: #FFFFFF;\n    box-shadow: 0 12px 26px -10px rgba(197,97,63,0.5);\n    display: flex; align-items: center; justify-content: center;\n    transition: transform 260ms cubic-bezier(0.16,1,0.3,1), background 260ms cubic-bezier(0.16,1,0.3,1);\n  }\n  .bk-orb-btn:hover { transform: translateY(-2px); }\n  .bk-orb-btn:active { transform: scale(0.96); }\n  .bk-orb-btn:focus-visible { outline: 2px solid #c5613f; outline-offset: 3px; }\n  .bk-orb-ic { width: 20px; height: 20px; position: relative; z-index: 2; }\n  .bk-orb[data-state=\"active\"] .bk-orb-btn {\n    background: #18181B;\n    animation: bk-breathe 2.4s ease-in-out infinite;\n  }\n  @keyframes bk-breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }\n\n  .bk-orb-rings { position: absolute; inset: 0; pointer-events: none; }\n  .bk-orb-rings span {\n    position: absolute; inset: 0; border-radius: 50%;\n    border: 2px solid #c5613f; opacity: 0;\n  }\n  .bk-orb[data-state=\"active\"] .bk-orb-rings span { animation: bk-ring 2.2s cubic-bezier(0.16,1,0.3,1) infinite; }\n  .bk-orb[data-state=\"active\"] .bk-orb-rings span:nth-child(2) { animation-delay: 0.73s; }\n  .bk-orb[data-state=\"active\"] .bk-orb-rings span:nth-child(3) { animation-delay: 1.46s; }\n  @keyframes bk-ring { 0% { opacity: 0.5; transform: scale(1); } 100% { opacity: 0; transform: scale(2.1); } }\n\n  .bk-orb-status {\n    position: absolute; top: 0; right: 0; width: 10px; height: 10px;\n    border-radius: 50%; background: #94A3B8; border: 2px solid #f9f9f7; z-index: 3;\n    transition: background 240ms;\n  }\n  .bk-orb[data-state=\"active\"] .bk-orb-status { background: #16A34A; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .bk-orb-btn, .bk-orb-label { transition: none; }\n    .bk-orb[data-state=\"active\"] .bk-orb-btn { animation: none; }\n    .bk-orb[data-state=\"active\"] .bk-orb-rings span { animation: none; opacity: 0; }\n  }\n</style>\n<div class=\"bk-orb\" id=\"bk-orb\" data-state=\"idle\">\n  <span class=\"bk-orb-label\"><span class=\"bk-orb-txt\">Talk to Booklesss</span><span class=\"soon\">soon</span></span>\n  <button class=\"bk-orb-btn\" type=\"button\" aria-pressed=\"false\" aria-label=\"Talk to Booklesss — voice tutor coming soon\">\n    <span class=\"bk-orb-rings\" aria-hidden=\"true\"><span></span><span></span><span></span></span>\n    <span class=\"bk-orb-status\" aria-hidden=\"true\"></span>\n    <svg class=\"bk-orb-ic\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M12 15.5a3.5 3.5 0 0 0 3.5-3.5V6a3.5 3.5 0 1 0-7 0v6a3.5 3.5 0 0 0 3.5 3.5Z\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n      <path d=\"M19 12a7 7 0 0 1-14 0\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      <path d=\"M12 19v3\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n    </svg>\n  </button>\n</div>\n<script>\n(function () {\n  var orb = document.getElementById(\"bk-orb\");\n  if (!orb) return;\n  var btn = orb.querySelector(\".bk-orb-btn\");\n  var txt = orb.querySelector(\".bk-orb-txt\");\n  btn.addEventListener(\"click\", function () {\n    var active = orb.getAttribute(\"data-state\") === \"active\";\n    orb.setAttribute(\"data-state\", active ? \"idle\" : \"active\");\n    btn.setAttribute(\"aria-pressed\", String(!active));\n    txt.textContent = active ? \"Talk to Booklesss\" : \"Listening…\";\n  });\n})();\n</script>\n"
}
